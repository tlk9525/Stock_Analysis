#!/usr/bin/env bash
# Run the FinAI single-symbol pipeline from any working directory.
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink "$SOURCE_PATH")"
  [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="${SOURCE_DIR}/${SOURCE_PATH}"
done
PROJECT_DIR="$(cd "$(dirname "$SOURCE_PATH")/.." && pwd)"
PYTHON_BIN="${PROJECT_DIR}/.venv/bin/python"

if [[ ! -x "$PYTHON_BIN" ]]; then
  echo "Không tìm thấy Python virtual environment: ${PYTHON_BIN}" >&2
  echo "Hãy tạo .venv và cài dependencies trước khi chạy stockrun." >&2
  exit 1
fi

cd "$PROJECT_DIR"

# ``VN100`` is a batch shortcut, not a listed security code.  Keep this before
# the normal single-symbol fallback so `stockrun VN100` never attempts to
# download prices for a fictitious VN100 ticker.
if [[ "${1:-}" == "VN100" ]]; then
  exec "$PROJECT_DIR/scripts/run_vn100_full_batch.sh" "${@:2}"
fi

if [[ "${1:-}" == "full" && "${2:-}" == "VN100" ]]; then
  exec "$PROJECT_DIR/scripts/run_vn100_full_batch.sh" "${@:3}"
fi

# The common case is intentionally terse: `stockrun FPT` runs ML, research and AI.
# Named FinAI commands remain available for individual workflow steps.
case "${1:-}" in
  doctor|analyze|full|rank|research|export-news-history|collect-news|train-symbol-news|portfolio|ai|--help|-h|help|"")
    exec "$PYTHON_BIN" -m src.finai_cli "$@"
    ;;
  *)
    exec "$PYTHON_BIN" -m src.finai_cli full "$@"
    ;;
esac
